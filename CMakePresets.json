{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug",
            "generator": "Ninja",
            "binaryDir": "bin/Debug",
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Visual Studio 22"
                }
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_C_FLAGS_INIT": "/Od /W3 /sdl /Zi",
                "CMAKE_CXX_FLAGS_INIT": "/Od /W3 /sdl /Zi"
            }
        },
        {
            "name": "debugLinux",
            "displayName": "Debug (Linux)",
            "description": "Debug (Linux)",
            "generator": "Ninja",
            "binaryDir": "bin/Debug",
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Visual Studio 22"
                }
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_FLAGS_INIT": "-O0 -ggdb -w",
                "CMAKE_CXX_FLAGS_INIT": "-O0 -ggdb -w -fpermissive"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Release",
            "generator": "Ninja",
            "binaryDir": "bin/Release",
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Visual Studio 22"
                }
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_C_FLAGS_INIT": "/GL /O2 /W3",
                "CMAKE_CXX_FLAGS_INIT": "/GL /O2 /W3 /sdl"
            }
        },
        {
            "name": "releaseLinux",
            "displayName": "Release (Linux)",
            "description": "Release (Linux)",
            "generator": "Ninja",
            "binaryDir": "bin/Release",
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Visual Studio 22"
                }
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_FLAGS_INIT": "-O3 -w",
                "CMAKE_CXX_FLAGS_INIT": "-O3 -w -fpermissive"
            }
        },
        {
            "name": "dist",
            "displayName": "Distribution",
            "description": "Distribution",
            "generator": "Ninja",
            "binaryDir": "bin/Dist",
            "vendor": {
                "jetbrains.com/clion": {
                    "toolchain": "Visual Studio 22"
                }
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Dist",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_C_FLAGS_INIT": "/GL /O2 /W3",
                "CMAKE_CXX_FLAGS_INIT": "/GL /O2 /W3 /sdl"
            }
        }
    ]
}
