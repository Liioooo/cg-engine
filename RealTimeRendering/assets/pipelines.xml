<Pipelines>
    <ComputePipeline name="ocean/init-spectrum">
        <Shader>ocean/initSpectrum_comp</Shader>
        <DescriptorSetLayout>
            <UboBindingPoints>
                <Binding bindingPoint="3" usage="Compute"/>
            </UboBindingPoints>
            <Texture2DAndAttachmentBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
            </Texture2DAndAttachmentBindingPoints>
            <ImageBindingPoints>
                <Binding bindingPoint="1" usage="Compute"/>
                <Binding bindingPoint="2" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
    </ComputePipeline>
    <ComputePipeline name="ocean/conjugate">
        <Shader>ocean/conjugate_comp</Shader>
        <DescriptorSetLayout>
            <ImageBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
    </ComputePipeline>
    <ComputePipeline name="ocean/simulate-ocean">
        <Shader>ocean/simulateOcean_comp</Shader>
        <DescriptorSetLayout>
            <ImageBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
                <Binding bindingPoint="1" usage="Compute"/>
                <Binding bindingPoint="2" usage="Compute"/>
                <Binding bindingPoint="3" usage="Compute"/>
                <Binding bindingPoint="4" usage="Compute"/>
                <Binding bindingPoint="5" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
        <PushConstants size="4" />
    </ComputePipeline>
    <ComputePipeline name="ocean/fft/precomputeTwiddleFactorsAndInputIndices">
        <Shader>ocean/fft/precomputeTwiddleFactorsAndInputIndices_comp</Shader>
        <DescriptorSetLayout>
            <ImageBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
        <PushConstants size="4" />
    </ComputePipeline>
    <ComputePipeline name="ocean/fft/horizontalStepInverseFft">
        <Shader>ocean/fft/horizontalStepInverseFft_comp</Shader>
        <DescriptorSetLayout>
            <ImageBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
                <Binding bindingPoint="1" usage="Compute"/>
                <Binding bindingPoint="2" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
        <PushConstants size="8" />
    </ComputePipeline>
    <ComputePipeline name="ocean/fft/verticalStepInverseFft">
        <Shader>ocean/fft/verticalStepInverseFft_comp</Shader>
        <DescriptorSetLayout>
            <ImageBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
                <Binding bindingPoint="1" usage="Compute"/>
                <Binding bindingPoint="2" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
        <PushConstants size="8" />
    </ComputePipeline>
    <ComputePipeline name="ocean/fft/permute">
        <Shader>ocean/fft/permute_comp</Shader>
        <DescriptorSetLayout>
            <ImageBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
    </ComputePipeline>
    <ComputePipeline name="ocean/compute-final">
        <Shader>ocean/computeFinalTextures_comp</Shader>
        <DescriptorSetLayout>
            <ImageBindingPoints>
                <Binding bindingPoint="0" usage="Compute"/>
                <Binding bindingPoint="1" usage="Compute"/>
                <Binding bindingPoint="2" usage="Compute"/>
                <Binding bindingPoint="3" usage="Compute"/>
                <Binding bindingPoint="4" usage="Compute"/>
                <Binding bindingPoint="5" usage="Compute"/>
                <Binding bindingPoint="6" usage="Compute"/>
            </ImageBindingPoints>
        </DescriptorSetLayout>
        <PushConstants size="8" />
    </ComputePipeline>
    <GraphicsPipeline name="ocean/render">
        <Shader>
            <Vertex>ocean/ocean_vertex</Vertex>
            <Fragment>ocean/ocean_fragment</Fragment>
            <Tcs>ocean/ocean_tcs</Tcs>
            <Tes>ocean/ocean_tes</Tes>
        </Shader>
        <VertexBufferLayouts>
            <VertexBufferLayout>
                <VertexBufferElement data-type="Float4" normalized="true" />
                <VertexBufferElement data-type="Float4" normalized="true" />
                <VertexBufferElement data-type="Float4" normalized="true" />
                <VertexBufferElement data-type="Float4" normalized="true" />
                <VertexBufferElement data-type="Float4" normalized="true" />
            </VertexBufferLayout>
        </VertexBufferLayouts>
        <DescriptorSetLayout>
            <UboBindingPoints>
                <Binding bindingPoint="2" usage="Fragment,TES"/>
            </UboBindingPoints>
            <Texture2DAndAttachmentBindingPoints>
                <Binding bindingPoint="10" usage="Fragment,TES"/>
                <Binding bindingPoint="11" usage="Fragment,TES"/>
                <Binding bindingPoint="12" usage="Fragment,TES"/>
                <Binding bindingPoint="13" usage="Fragment,TES"/>
                <Binding bindingPoint="14" usage="Fragment,TES"/>
                <Binding bindingPoint="15" usage="Fragment,TES"/>
                <Binding bindingPoint="17" usage="Fragment,TES"/>
                <Binding bindingPoint="18" usage="Fragment,TES"/>
                <Binding bindingPoint="19" usage="Fragment,TES"/>
            </Texture2DAndAttachmentBindingPoints>
        </DescriptorSetLayout>
        <DepthCompareOperator>Less</DepthCompareOperator>
        <DepthTest>true</DepthTest>
        <DepthWrite>true</DepthWrite>
        <Wireframe>false</Wireframe>
        <BackfaceCulling>true</BackfaceCulling>
        <FrontfaceCulling>false</FrontfaceCulling>
        <UseBlending>false</UseBlending>
        <BlendingEquation>Add</BlendingEquation>
        <SrcBlendingFunction>SrcAlpha</SrcBlendingFunction>
        <DestBlendingFunction>OneMinusSrcAlpha</DestBlendingFunction>
        <TesselationPatchSize>4</TesselationPatchSize>
        <DrawMode>Patches</DrawMode>
    </GraphicsPipeline>
    <GraphicsPipeline name="grass/render">
        <Shader>
            <Vertex>grass/grass_vertex</Vertex>
            <Fragment>grass/grass_fragment</Fragment>
        </Shader>
        <VertexBufferLayouts>
            <VertexBufferLayout>
                <VertexBufferElement data-type="Int" normalized="false" />
            </VertexBufferLayout>
        </VertexBufferLayouts>
        <DescriptorSetLayout>
            <Texture2DAndAttachmentBindingPoints>
                <Binding bindingPoint="10" usage="Vertex"/>
            </Texture2DAndAttachmentBindingPoints>
            <UboBindingPoints>
                <Binding bindingPoint="2" usage="Vertex"/>
            </UboBindingPoints>
            <ImmutableSsboBindingPoints>
                <Binding bindingPoint="6" usage="Vertex"/>
            </ImmutableSsboBindingPoints>
        </DescriptorSetLayout>
        <DepthCompareOperator>Less</DepthCompareOperator>
        <DepthTest>true</DepthTest>
        <DepthWrite>true</DepthWrite>
        <Wireframe>false</Wireframe>
        <BackfaceCulling>true</BackfaceCulling>
        <FrontfaceCulling>false</FrontfaceCulling>
        <UseBlending>false</UseBlending>
        <BlendingEquation>Add</BlendingEquation>
        <SrcBlendingFunction>SrcAlpha</SrcBlendingFunction>
        <DestBlendingFunction>OneMinusSrcAlpha</DestBlendingFunction>
        <TesselationPatchSize>0</TesselationPatchSize>
        <DrawMode>Triangles</DrawMode>
    </GraphicsPipeline>
</Pipelines>

